# Copy file này thành .env rồi điền giá trị thật. .env không lên git.

PORT=3000
CORS_ORIGIN=http://localhost:3001

# Kết nối runtime. Supabase: cổng 6543 là transaction pooler (pgbouncer), 5432 là session pooler.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=enshido&sslmode=require

# BẮT BUỘC phải có, kể cả khi trùng DATABASE_URL: schema.prisma khai báo directUrl, thiếu biến này
# thì mọi lệnh prisma (migrate/status/db execute) thoát ngay với P1012 mà chưa kết nối DB.
# Phải là kết nối chạy được DDL — dùng cổng 5432, không dùng 6543.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=enshido&sslmode=require

JWT_SECRET=doi-thanh-chuoi-random-64-ky-tu
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=7d

# true khi chạy sau HTTPS.
COOKIE_SECURE=false
NODE_ENV=development

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=enshido/orders
