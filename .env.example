PORT=3000
FE_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# Database
#
# LOCAL (máy dev): Postgres chạy bằng `docker compose up -d`, xem docker-compose.yml.
#   Không đi qua pooler nên DIRECT_URL trùng DATABASE_URL.
#
#   DATABASE_URL=postgresql://enshido:enshido@localhost:5433/enshido?schema=public
#   DIRECT_URL=postgresql://enshido:enshido@localhost:5433/enshido?schema=public
#
# SERVER (production): Supabase.
#   DATABASE_URL đi transaction pooler cổng 6543 — src/prisma/database-url.ts tự
#   thêm pgbouncer=true khi thấy cổng này.
#   DIRECT_URL đi session pooler cổng 5432 — prisma migrate không chạy qua pgbouncer.
#
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=public&sslmode=require&pgbouncer=true&connection_limit=8&pool_timeout=20
#   DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
NODE_ENV=development

# Cloudinary — lưu ảnh đơn sản xuất (ảnh chi tiết đơn, ảnh sản phẩm).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=enshido/orders
