generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime đi qua pgbouncer (6543); migration phải đi kết nối trực tiếp (5432).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleCode {
  ADMIN
  USER
  /// Thợ sản xuất: chỉ làm việc trên phiếu con của mình, không vào màn quản lý đơn.
  WORKER
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique
  email        String?    @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  roleCode     RoleCode   @map("role_code")
  extraRoles      RoleCode[] @default([]) @map("extra_roles")
  /// Các màn hình USER được xem. ADMIN bỏ qua cột này (luôn xem hết).
  allowedScreens  String[]   @default([]) @map("allowed_screens")
  department      String?
  isActive        Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]

  @@index([roleCode, isActive])
  @@map("users")
}

/// Chất liệu NVL — đã có sẵn trên DB, dùng cho cột materials.metal_kind.
enum MetalKind {
  SILVER
  GOLD
  STONE
  ALLOY
  COPPER
}

enum MaterialClass {
  RAW_MATERIAL
  CONSUMABLE
  SEMI_FINISHED
}

enum OtherClassKind {
  CATALOG
  OTHER
}

/// Kho vật lý. Kho NVL chính chứa nhập / xuất / tồn.
model Warehouse {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  shortName   String   @map("short_name")
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent    Warehouse?          @relation("WarehouseTree", fields: [parentId], references: [id])
  children  Warehouse[]         @relation("WarehouseTree")
  materials Material[]
  balances  StockBalance[]
  inbounds  StockInbound[]
  outbounds StockOutbound[]
  destOutbounds StockOutbound[] @relation("OutboundTransferDest")
  sourceInbounds StockInbound[] @relation("InboundTransferSource")
  btpItems  BtpWaitingItem[]
  locations WarehouseLocation[]

  @@index([parentId, sortOrder])
  @@map("warehouses")
}

/// Ô kệ cấu hình sẵn. Mã = Zone + Dãy + Tầng + Số (vd A1C12).
model WarehouseLocation {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  zone        String
  aisle       Int
  level       String
  position    Int
  code        String
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, code])
  @@index([warehouseId, isActive, sortOrder])
  @@index([warehouseId, zone, aisle, level, position], map: "warehouse_locations_wh_slot_idx")
  @@map("warehouse_locations")
}

model Unit {
  id        String @id @default(uuid()) @db.Uuid
  code      String @unique
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  materials Material[]
  inbounds  StockInbound[]
  outbounds StockOutbound[]
  btpItems  BtpWaitingItem[]

  @@map("units")
}

/// Loại / danh mục con NVL (Bạc A, Đá Moiss, …), gắn với nhóm metalKind.
model MaterialType {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique
  name      String
  metalKind MetalKind? @map("metal_kind")
  sortOrder Int        @default(0) @map("sort_order")

  materials Material[]

  @@index([metalKind, sortOrder])
  @@map("material_types")
}

/// Danh mục / Phân loại khác — cây danh mục to + danh mục con.
model OtherClass {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique
  name      String
  kind      OtherClassKind @default(CATALOG)
  parentId  String?        @map("parent_id") @db.Uuid
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  parent         OtherClass?  @relation("OtherClassTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       OtherClass[] @relation("OtherClassTree")
  materials      Material[]
  bodyMetalOf    Material[]   @relation("MaterialBodyMetal")
  productKindOf  Material[]   @relation("MaterialProductKind")
  platingColorOf Material[]   @relation("MaterialPlatingColor")

  @@index([kind, sortOrder])
  @@index([parentId])
  @@map("other_classes")
}

model Shape {
  id        String @id @default(uuid()) @db.Uuid
  code      String @unique
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  materials Material[]

  @@map("shapes")
}

model Color {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique
  name      String
  skuLetter String? @map("sku_letter")
  sortOrder Int     @default(0) @map("sort_order")

  materials Material[]

  @@map("colors")
}

/// Master NVL — một dòng trên tab Tồn kho.
model Material {
  id             String        @id @default(uuid()) @db.Uuid
  warehouseId    String        @map("warehouse_id") @db.Uuid
  sku            String?
  name           String
  locationCode   String?       @map("location_code")
  unitId         String        @map("unit_id") @db.Uuid
  materialTypeId String?       @map("material_type_id") @db.Uuid
  otherClassId   String?       @map("other_class_id") @db.Uuid
  /// Chất liệu (kho BTP) — danh mục con của parent `chat-lieu`.
  bodyMetalId    String?       @map("body_metal_id") @db.Uuid
  /// Phân loại sản phẩm (kho BTP) — danh mục con của parent `phan-loai-san-pham`.
  productKindId  String?       @map("product_kind_id") @db.Uuid
  /// Màu xi (kho BTP) — danh mục con của parent `mau-xi`. Màu đá dùng `colorId`.
  platingColorId String?       @map("plating_color_id") @db.Uuid
  shapeId        String?       @map("shape_id") @db.Uuid
  colorId        String?       @map("color_id") @db.Uuid
  sizeLabel      String?       @map("size_label")
  quality        String?
  note           String?
  classification MaterialClass @default(RAW_MATERIAL)
  metalKind      MetalKind?    @map("metal_kind")
  sortOrder      Int           @default(0) @map("sort_order")
  /// Tồn kho SL < ngưỡng này → Trạng thái "Sắp hết hàng". Mặc định 5.
  reorderPoint   Decimal       @default(5) @map("reorder_point") @db.Decimal(18, 4)
  isLocked       Boolean       @default(false) @map("is_locked")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  unit         Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  materialType MaterialType?   @relation(fields: [materialTypeId], references: [id], onDelete: SetNull)
  otherClass   OtherClass?     @relation(fields: [otherClassId], references: [id], onDelete: SetNull)
  bodyMetal    OtherClass?     @relation("MaterialBodyMetal", fields: [bodyMetalId], references: [id], onDelete: SetNull)
  productKind  OtherClass?     @relation("MaterialProductKind", fields: [productKindId], references: [id], onDelete: SetNull)
  platingColor OtherClass?     @relation("MaterialPlatingColor", fields: [platingColorId], references: [id], onDelete: SetNull)
  shape        Shape?          @relation(fields: [shapeId], references: [id], onDelete: SetNull)
  color        Color?          @relation(fields: [colorId], references: [id], onDelete: SetNull)
  balance      StockBalance?
  inbounds     StockInbound[]
  outbounds    StockOutbound[]
  images       MaterialImage[]
  btpOrders    ProductionOrder[] @relation("OrderBtpMaterial")
  nvlOrders    ProductionOrder[] @relation("OrderNvlMaterial")

  @@unique([warehouseId, sku])
  @@unique([sku], map: "materials_sku_key")
  @@index([warehouseId, isActive, sortOrder])
  @@index([warehouseId, locationCode], map: "materials_warehouse_id_location_code_idx")
  @@index([materialTypeId])
  @@index([bodyMetalId])
  @@index([productKindId])
  @@index([platingColorId])
  @@map("materials")
}

/// Ảnh sản phẩm của một dòng kho (dùng cho BTP). Lên đơn BTP chép ảnh sang đơn, dùng chung publicId.
model MaterialImage {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  url        String
  publicId   String   @map("public_id")
  width      Int?
  height     Int?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, sortOrder])
  @@index([publicId])
  @@map("material_images")
}

/// Số liệu NXT của 1 NVL trong 1 kho. Tồn = đầu kỳ + nhập − xuất.
model StockBalance {
  id             String    @id @default(uuid()) @db.Uuid
  warehouseId    String    @map("warehouse_id") @db.Uuid
  materialId     String    @unique @map("material_id") @db.Uuid
  openingQty     Decimal   @default(0) @map("opening_qty") @db.Decimal(18, 4)
  openingAmount  Decimal   @default(0) @map("opening_amount") @db.Decimal(18, 2)
  /// Đơn giá tồn — cấu hình tại Kho đơn giá. TT đầu kỳ = SL đầu kỳ × giá này.
  stockUnitPrice Decimal   @default(0) @map("stock_unit_price") @db.Decimal(18, 2)
  inQty          Decimal   @default(0) @map("in_qty") @db.Decimal(18, 4)
  inAmount       Decimal   @default(0) @map("in_amount") @db.Decimal(18, 2)
  outQty         Decimal   @default(0) @map("out_qty") @db.Decimal(18, 4)
  outAmount      Decimal   @default(0) @map("out_amount") @db.Decimal(18, 2)
  qty            Decimal   @default(0) @db.Decimal(18, 4)
  amount         Decimal   @default(0) @db.Decimal(18, 2)
  /// Số kiểm kê thực tế tại kho — cột "Tồn thực tế" trên sheet Excel.
  /// Null = chưa kiểm kê. Chênh lệch = countedQty − qty, tính động chứ không lưu.
  countedQty     Decimal?  @map("counted_qty") @db.Decimal(18, 4)
  countedAt      DateTime? @map("counted_at") @db.Date
  updatedAt      DateTime  @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  material  Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, materialId])
  @@index([warehouseId])
  @@map("stock_balances")
}

/// Nhà cung cấp đá / NVL — cột NCC trên sheet Nhập kho đá (Hongkong, Hagems, ...).
model Supplier {
  id        String @id @default(uuid()) @db.Uuid
  code      String @unique
  name      String
  sortOrder Int    @default(0) @map("sort_order")

  inbounds StockInbound[]

  @@map("suppliers")
}

/// Một dòng trên tab Nhập kho đá.
model StockInbound {
  id             String   @id @default(uuid()) @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  materialId     String?  @map("material_id") @db.Uuid
  sortOrder      Int      @default(0) @map("sort_order")
  receivedAt     DateTime @map("received_at") @db.Date
  name           String
  sku            String?
  unitId         String?  @map("unit_id") @db.Uuid
  unitName       String   @map("unit_name")
  qty            Decimal  @db.Decimal(18, 4)
  stockUnitPrice Decimal  @default(0) @map("stock_unit_price") @db.Decimal(18, 2)
  unitPrice      Decimal  @default(0) @map("unit_price") @db.Decimal(18, 2)
  amount         Decimal  @default(0) @db.Decimal(18, 2)
  note           String?
  /// Người lập phiếu — cột đã có sẵn trên DB.
  enteredBy      String?  @map("entered_by")
  supplierSku    String?  @map("supplier_sku")
  supplierId     String?  @map("supplier_id") @db.Uuid
  supplierName   String?  @map("supplier_name")
  /// Seed lịch sử = false (tồn kho đá đã gồm số nhập). Phiếu mới từ UI = true.
  applyToStock   Boolean  @default(false) @map("apply_to_stock")
  /// Phiếu nhập do xuất chuyển kho tạo ra.
  sourceWarehouseId String? @map("source_warehouse_id") @db.Uuid
  sourceOutboundId  String? @unique @map("source_outbound_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sourceWarehouse Warehouse? @relation("InboundTransferSource", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  material  Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([warehouseId, sortOrder])
  @@index([warehouseId, receivedAt])
  @@index([warehouseId, sortOrder])
  @@index([warehouseId, materialId, applyToStock], map: "stock_inbounds_wh_mat_apply_idx")
  @@index([materialId], map: "stock_inbounds_material_id_idx")
  @@map("stock_inbounds")
}

/// Một dòng trên tab Xuất NVL đá.
model StockOutbound {
  id                String   @id @default(uuid()) @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  materialId        String?  @map("material_id") @db.Uuid
  sortOrder         Int      @default(0) @map("sort_order")
  issuedAt          DateTime @map("issued_at") @db.Date
  name              String
  sku               String?
  unitId            String?  @map("unit_id") @db.Uuid
  unitName          String   @map("unit_name")
  qty               Decimal  @db.Decimal(18, 4)
  stockUnitPrice    Decimal  @default(0) @map("stock_unit_price") @db.Decimal(18, 2)
  inboundUnitPrice  Decimal  @default(0) @map("inbound_unit_price") @db.Decimal(18, 2)
  amount            Decimal  @default(0) @db.Decimal(18, 2)
  note              String?
  issuedBy          String?  @map("issued_by")
  receivedBy        String?  @map("received_by")
  /// Liên kết người nhận tới tài khoản — cột đã có sẵn trên DB.
  receivedByUserId  String?  @map("received_by_user_id") @db.Uuid
  /// Seed lịch sử = false (tồn kho đá đã gồm số xuất). Phiếu mới từ UI = true.
  applyToStock      Boolean  @default(false) @map("apply_to_stock")
  /// Đơn sản xuất dùng NVL này — nguồn chi phí NVL của đơn.
  productionOrderId String?  @map("production_order_id") @db.Uuid
  /// Phiếu xuất BTP do lên đơn BTP tự tạo — chỉ sửa / xoá qua đơn.
  autoIssued        Boolean  @default(false) @map("auto_issued")
  /// Xuất chuyển sang kho khác — phiếu nhập đối ứng.
  destWarehouseId   String?  @map("dest_warehouse_id") @db.Uuid
  destInboundId     String?  @unique @map("dest_inbound_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  destWarehouse   Warehouse?       @relation("OutboundTransferDest", fields: [destWarehouseId], references: [id], onDelete: SetNull)
  material        Material?        @relation(fields: [materialId], references: [id], onDelete: SetNull)
  unit            Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, sortOrder])
  @@index([warehouseId, issuedAt])
  @@index([warehouseId, sortOrder])
  @@index([warehouseId, materialId, applyToStock], map: "stock_outbounds_wh_mat_apply_idx")
  @@index([materialId], map: "stock_outbounds_material_id_idx")
  @@index([productionOrderId])
  @@map("stock_outbounds")
}

/// Sổ Kho BTP — theo dõi dòng, không nhập / xuất / tồn.
model BtpWaitingItem {
  id              String   @id @default(uuid()) @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  receivedAt      DateTime @map("received_at") @db.Date
  craftsmanUserId String?  @map("craftsman_user_id") @db.Uuid
  craftsmanName   String   @map("craftsman_name")
  name            String
  unitId          String?  @map("unit_id") @db.Uuid
  unitName        String   @map("unit_name")
  qty             Decimal  @db.Decimal(18, 4)
  weight          Decimal  @default(0) @db.Decimal(18, 4)
  note            String?
  enteredBy       String?  @map("entered_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([warehouseId, sortOrder])
  @@index([warehouseId, receivedAt])
  @@index([warehouseId, sortOrder])
  @@map("btp_waiting_items")
}

/// Trạng thái đơn sản xuất, xếp theo luồng: Nguội → Vào đá → Khắc → Bóng → Xi → Lỗi / Hoàn thiện.
enum ProductionStatus {
  NEW
  REDO_3D
  CASTING
  FILING
  STONE_SETTING
  ENGRAVING
  POLISHING
  PLATING
  DEFECT
  FINISHING
  DELIVERED
}

/// Yêu cầu làm hàng: Dựng mẫu / Đơn khách lẻ / SX SLL.
enum ProductionRequestType {
  SAMPLE
  RETAIL
  BULK
}

/// Loại đơn: làm từ NVL (3D → Đúc → khâu) hoặc lấy BTP có sẵn trong kho BTP (bỏ 3D + Đúc).
enum ProductionSource {
  NVL
  BTP
}

enum ProductionImageKind {
  DETAIL
  PRODUCT
}

/// Khâu giao thợ trên phiếu. Đúc nằm ở đầu phiếu; Lỗi / Hoàn thiện là kết cục cuối phiếu, không phải khâu.
enum ProductionStage {
  FILING
  STONE_SETTING
  ENGRAVING
  POLISHING
  PLATING
}

/// Đơn sản xuất — một dòng trên danh sách đơn, in ra một phiếu cho thợ.
model ProductionOrder {
  id                  String                @id @default(uuid()) @db.Uuid
  /// Số thứ tự sinh mã SX (A001, A002…).
  seq                 Int                   @unique
  code                String                @unique
  status              ProductionStatus      @default(NEW)
  source              ProductionSource      @default(NVL)
  /// Mã BTP lấy ra làm đơn (đơn BTP). Phiếu xuất BTP tự tạo gắn mã đơn, `autoIssued = true`.
  btpMaterialId       String?               @map("btp_material_id") @db.Uuid
  /// Mã NVL lấy ra làm Đơn mới. Phiếu xuất NVL tự tạo gắn mã đơn, `autoIssued = true`.
  nvlMaterialId       String?               @map("nvl_material_id") @db.Uuid
  /// Mã thành phẩm lấy từ kho thành phẩm khi lên Đơn mới.
  sourceOrderCode     String?               @map("source_order_code")
  requestType         ProductionRequestType @map("request_type")
  qty                 Int                   @default(1)
  /// Đơn vị số lượng cần làm: chiếc | đôi.
  qtyUnit             String?               @map("qty_unit")
  /// Số lượng thành phẩm cần lên đơn (form Đơn mới).
  finishedProductQty  Int?                  @map("finished_product_qty")
  /// Cột "Đã trả" trên Lark.
  returnedQty         Int                   @default(0) @map("returned_qty")
  model3dCode         String?               @map("model_3d_code")
  model3dUrl          String?               @map("model_3d_url")
  leadTime            String?               @map("lead_time")
  /// Mã theo dõi đơn bên bán hàng, vd V-9147.
  trackingCode        String?               @map("tracking_code")
  closedBy            String                @map("closed_by")
  description         String
  stoneColor          String?               @map("stone_color")
  stoneTypes          String[]              @default([]) @map("stone_types")
  /// Kích thước (đường kính, dài…). Size nhẫn / lắc nằm ở `sizeLabel`.
  size                String?
  sizeLabel           String?               @map("size_label")
  stoneCount          Int?                  @map("stone_count")
  stoneWeight         Decimal?              @map("stone_weight") @db.Decimal(18, 4)
  laserEngraving      String?               @map("laser_engraving")
  otherRequirements   String?               @map("other_requirements")
  mainMaterial        String?               @map("main_material")
  platingColor        String?               @map("plating_color")
  /// Danh mục BTP (form Đơn BTP).
  btpCategory         String?               @map("btp_category")
  /// Phân loại sản phẩm kho BTP.
  productKind         String?               @map("product_kind")
  askedUserId         String?               @map("asked_user_id") @db.Uuid
  askedUserName       String?               @map("asked_user_name")
  /// Ngày đặt đơn trên phiếu.
  receivedDate        DateTime              @map("received_date") @db.Date
  dueDate             DateTime?             @map("due_date") @db.Date
  /// Ngày báo Đúc — có ngày này đơn mới được in phiếu thợ.
  castingSentDate     DateTime?             @map("casting_sent_date") @db.Date
  castingReturnedDate DateTime?             @map("casting_returned_date") @db.Date
  debtStatus          String?               @map("debt_status")
  /// Tổng trọng lượng bạc của đơn (g) — mốc chia gram bạc cho các phiếu con.
  silverWeight        Decimal?              @map("silver_weight") @db.Decimal(18, 4)
  parentId            String?               @map("parent_id") @db.Uuid
  lastPrintedAt       DateTime?             @map("last_printed_at")
  /// Lần cuối nội dung in trên phiếu thay đổi. Tách khỏi updatedAt vì đánh dấu "đã in" cũng làm updatedAt đổi.
  dataChangedAt       DateTime              @default(now()) @map("data_changed_at")
  createdBy           String?               @map("created_by")
  /// Người lên đơn — có quyền chia phiếu con. Đơn tạo trước khi có cột này để trống.
  createdByUserId     String?               @map("created_by_user_id") @db.Uuid
  /// Số phiếu con đã cấp (A012-1, A012-2…). Chỉ tăng, số của phiếu đã xoá không cấp lại.
  subTicketSeq        Int                   @default(0) @map("sub_ticket_seq")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  parent        ProductionOrder?       @relation("ProductionOrderTree", fields: [parentId], references: [id], onDelete: SetNull)
  btpMaterial   Material?              @relation("OrderBtpMaterial", fields: [btpMaterialId], references: [id], onDelete: SetNull)
  nvlMaterial   Material?              @relation("OrderNvlMaterial", fields: [nvlMaterialId], references: [id], onDelete: SetNull)
  children      ProductionOrder[]      @relation("ProductionOrderTree")
  images        ProductionOrderImage[]
  stages        ProductionStageEntry[]
  subTickets    ProductionSubTicket[]
  statusLogs    ProductionStatusLog[]
  outbounds     StockOutbound[]
  costs         ProductionOrderCost[]
  receipt       FinishedGoodsReceipt?
  shipmentLines ShipmentLine[]
  autoShipments Shipment[]             @relation("OrderAutoShipment")

  @@index([status, createdAt])
  @@index([requestType])
  @@index([parentId])
  @@index([btpMaterialId])
  @@index([nvlMaterialId])
  @@map("production_orders")
}

model ProductionOrderImage {
  id        String              @id @default(uuid()) @db.Uuid
  orderId   String              @map("order_id") @db.Uuid
  kind      ProductionImageKind
  url       String
  publicId  String              @map("public_id")
  width     Int?
  height    Int?
  sortOrder Int                 @default(0) @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at")

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, kind, sortOrder])
  @@map("production_order_images")
}

/// Một cột khâu trên phiếu thợ. Giao cho thợ rồi KCS cân lại khi thợ nộp lại.
/// Người giao / người KCS do server ghi từ tài khoản đăng nhập. `attempt` tăng khi làm lại.
model ProductionStageEntry {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @map("order_id") @db.Uuid
  /// Phiếu con của thợ; null = khâu giao cho cả đơn (đơn chưa chia phiếu con).
  subTicketId           String?         @map("sub_ticket_id") @db.Uuid
  stage                 ProductionStage
  /// Lần làm của khâu, đếm riêng trong từng phiếu con.
  attempt               Int             @default(1)
  handedByUserId        String?         @map("handed_by_user_id") @db.Uuid
  handedByName          String          @map("handed_by_name")
  handedAt              DateTime        @map("handed_at")
  /// Số lượng sản phẩm giao cho thợ (mặc định cả đơn).
  handedQty             Int?            @map("handed_qty")
  /// Trọng lượng bạc giao (hao hụt chỉ tính trên bạc).
  handedSilverWeight    Decimal?        @map("handed_silver_weight") @db.Decimal(18, 4)
  craftsmanUserId       String?         @map("craftsman_user_id") @db.Uuid
  craftsmanName         String          @map("craftsman_name")
  /// Thợ bấm "Đã làm xong" — tín hiệu cho KCS, không chặn bước nhận lại.
  submittedAt           DateTime?       @map("submitted_at")
  submittedByUserId     String?         @map("submitted_by_user_id") @db.Uuid
  submittedByName       String?         @map("submitted_by_name")
  returnedByUserId      String?         @map("returned_by_user_id") @db.Uuid
  /// Người KCS — nhân viên cân lại bạc khi thợ nộp lại.
  returnedByName        String?         @map("returned_by_name")
  returnedAt            DateTime?       @map("returned_at")
  /// Số lượng KCS nhận lại — ít hơn số giao khi có hàng hỏng ở khâu.
  returnedQty           Int?            @map("returned_qty")
  returnedSilverWeight  Decimal?        @map("returned_silver_weight") @db.Decimal(18, 4)
  btpRecoveredWeight    Decimal?        @map("btp_recovered_weight") @db.Decimal(18, 4)
  silverRecoveredWeight Decimal?        @map("silver_recovered_weight") @db.Decimal(18, 4)
  /// Tiền công khâu, nhập khi KCS nhận lại.
  laborCost             Decimal?        @map("labor_cost") @db.Decimal(18, 2)
  note                  String?
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  order     ProductionOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subTicket ProductionSubTicket? @relation(fields: [subTicketId], references: [id], onDelete: Restrict)
  topUps    ProductionSubTicketTopUp[]

  // Không lặp khâu + lần trong cùng phiếu. Trên DB index này có thêm NULLS NOT DISTINCT
  // (xem prisma/migrations/0_init/migration.sql) — Prisma 6 chưa khai báo được phần đó.
  @@unique([orderId, subTicketId, stage, attempt], map: "production_stage_entries_order_ticket_stage_attempt_key")
  @@index([orderId, createdAt])
  @@index([subTicketId])
  @@index([craftsmanUserId, returnedAt])
  @@map("production_stage_entries")
}

/// Phiếu con chia từ đơn cho thợ: mỗi phiếu một phần số lượng + gram bạc, đi cùng các khâu
/// của đơn. Mỗi khâu được mở cho thợ tự nhận, người giao xác nhận giao rồi KCS nhận lại
/// như phiếu thường. Trạng thái (chờ nhận / đã nhận / đang làm) suy ra khi đọc, không lưu.
model ProductionSubTicket {
  id              String           @id @default(uuid()) @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  no              Int
  qty             Int
  silverWeight    Decimal          @map("silver_weight") @db.Decimal(18, 4)
  note            String?
  /// Khâu đang mở cho thợ nhận; về null khi người giao xác nhận giao hoặc huỷ mở khâu.
  pendingStage    ProductionStage? @map("pending_stage")
  pendingAt       DateTime?        @map("pending_at")
  pendingByName   String?          @map("pending_by_name")
  /// Thợ đã bấm nhận khâu đang mở, chờ người giao xác nhận.
  claimedByUserId String?          @map("claimed_by_user_id") @db.Uuid
  claimedByName   String?          @map("claimed_by_name")
  claimedAt       DateTime?        @map("claimed_at")
  /// Kết cục của riêng phiếu con: lỗi hoặc hoàn thiện. Còn null là phiếu vẫn đang chạy.
  outcome         SubTicketOutcome?
  outcomeAt       DateTime?        @map("outcome_at")
  outcomeByUserId String?          @map("outcome_by_user_id") @db.Uuid
  outcomeByName   String?          @map("outcome_by_name")
  /// Khâu phiếu đang ở lúc chốt kết cục — cột "Lỗi" trên phiếu ghi khâu nào lỗi.
  outcomeStage    ProductionStage? @map("outcome_stage")
  /// Số lượng chốt: hoàn thiện thì đây là số vào kho thành phẩm.
  outcomeQty      Int?             @map("outcome_qty")
  outcomeNote     String?          @map("outcome_note")
  lastPrintedAt   DateTime?        @map("last_printed_at")
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdByName   String           @map("created_by_name")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  order  ProductionOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stages ProductionStageEntry[]
  topUps ProductionSubTicketTopUp[]

  @@unique([orderId, no])
  @@index([pendingStage, claimedByUserId])
  @@index([claimedByUserId])
  @@map("production_sub_tickets")
}

/// Cấp thêm số lượng / bạc cho phiếu con khi thợ làm thiếu giữa chừng. Mỗi lần cấp là một
/// lần giao vật tư thật giữa hai người nên ghi riêng từng dòng, không cộng gộp.
model ProductionSubTicketTopUp {
  id              String   @id @default(uuid()) @db.Uuid
  subTicketId     String   @map("sub_ticket_id") @db.Uuid
  /// Khâu đã nhận phần cấp thêm này. Null = cấp lúc phiếu đang rảnh, phần này vào khâu sau.
  stageEntryId    String?  @map("stage_entry_id") @db.Uuid
  qty             Int      @default(0)
  silverWeight    Decimal  @default(0) @map("silver_weight") @db.Decimal(18, 4)
  reason          String?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdByName   String   @map("created_by_name")
  createdAt       DateTime @default(now()) @map("created_at")

  subTicket  ProductionSubTicket   @relation(fields: [subTicketId], references: [id], onDelete: Cascade)
  stageEntry ProductionStageEntry? @relation(fields: [stageEntryId], references: [id], onDelete: SetNull)

  @@index([subTicketId])
  @@index([stageEntryId])
  @@map("production_sub_ticket_top_ups")
}

/// Phiếu con kết thúc ở một trong hai nhánh, giống hai cột cuối của phiếu thợ.
enum SubTicketOutcome {
  DEFECT
  FINISH
}

model ProductionStatusLog {
  id         String            @id @default(uuid()) @db.Uuid
  orderId    String            @map("order_id") @db.Uuid
  fromStatus ProductionStatus? @map("from_status")
  toStatus   ProductionStatus  @map("to_status")
  note       String?
  changedBy  String?           @map("changed_by")
  changedAt  DateTime          @default(now()) @map("changed_at")

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, changedAt])
  @@map("production_status_logs")
}

/// Chi phí khác của đơn nhập tay (đúc thuê, 3D, thuê ngoài…).
model ProductionOrderCost {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  name          String
  amount        Decimal  @db.Decimal(18, 2)
  note          String?
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("production_order_costs")
}

/// Đơn vào kho thành phẩm khi KCS nhận lại khâu Ngoại Quan. Tồn = qty − tổng đã xuất.
model FinishedGoodsReceipt {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @unique @map("order_id") @db.Uuid
  qty              Int
  receivedAt       DateTime @map("received_at")
  receivedByUserId String?  @map("received_by_user_id") @db.Uuid
  receivedByName   String   @map("received_by_name")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([receivedAt])
  @@map("finished_goods_receipts")
}

/// Phiếu xuất hàng thành phẩm (PX0001).
model Shipment {
  id              String    @id @default(uuid()) @db.Uuid
  seq             Int       @unique
  code            String    @unique
  shippedAt       DateTime  @map("shipped_at") @db.Date
  customerName    String    @map("customer_name")
  paymentMethod   String?   @map("payment_method")
  note            String?
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdByName   String    @map("created_by_name")
  lastPrintedAt   DateTime? @map("last_printed_at")
  dataChangedAt   DateTime  @default(now()) @map("data_changed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  /// Phiếu xuất tự tạo khi lên Đơn mới (lấy thành phẩm có sẵn).
  autoIssued      Boolean   @default(false) @map("auto_issued")
  createdByOrderId String?  @map("created_by_order_id") @db.Uuid

  lines          ShipmentLine[]
  createdByOrder ProductionOrder? @relation("OrderAutoShipment", fields: [createdByOrderId], references: [id], onDelete: SetNull)

  @@index([shippedAt])
  @@index([createdByOrderId])
  @@map("shipments")
}

/// Một dòng hàng trên phiếu xuất. Chi phí được chụp lại lúc lập / sửa phiếu.
model ShipmentLine {
  id         String  @id @default(uuid()) @db.Uuid
  shipmentId String  @map("shipment_id") @db.Uuid
  orderId    String  @map("order_id") @db.Uuid
  qty        Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(18, 2)
  amount     Decimal @db.Decimal(18, 2)
  unitCost   Decimal @map("unit_cost") @db.Decimal(18, 2)
  costAmount Decimal @map("cost_amount") @db.Decimal(18, 2)
  note       String?
  sortOrder  Int     @default(0) @map("sort_order")

  shipment Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  order    ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([shipmentId, sortOrder])
  @@index([orderId])
  @@map("shipment_lines")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@map("refresh_tokens")
}
